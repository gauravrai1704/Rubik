\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Rubik's Square}, random states: mean solution length (HTM; on the Square HTM\,=\,QTM) of every method on the same instances ($n$ per size). In each row the \textcolor {red}{\textbf  {best}} method is red and the \textcolor {green!50!black}{\textbf  {second best}} green; only methods that solved every instance of that size are ranked, and ties share the colour. \textsc  {IDA$^*$-PDB}\xspace  : exact optimum (breadth-first search for $N\le 4$, IDA* for $N=5$). \textsc  {CayleyPy}\xspace  : per-size network, $W{=}4096$. A superscript gives the solved fraction when below 100\%. A dash means no result, for three reasons: \textsc  {IDA$^*$-PDB}\xspace  {} at $N\ge 6$, where no optimal solver finishes (0/10 states at $N=6$); \textsc  {CayleyPy}\xspace  {} at $N\ge 9$, for which no network was trained; \textsc  {OneNet}\xspace  {} at $N=3$, 13 and 15--20, not run.}}{11}{table.caption.44}\protected@file@percent }
\newlabel{tab:mainsq}{{5}{11}{\textbf {Rubik's Square}, random states: mean solution length (HTM; on the Square HTM\,=\,QTM) of every method on the same instances ($n$ per size). In each row the \best {best} method is red and the \second {second best} green; only methods that solved every instance of that size are ranked, and ties share the colour. \Mone : exact optimum (breadth-first search for $N\le 4$, IDA* for $N=5$). \Mfour : per-size network, $W{=}4096$. A superscript gives the solved fraction when below 100\%. A dash means no result, for three reasons: \Mone {} at $N\ge 6$, where no optimal solver finishes (0/10 states at $N=6$); \Mfour {} at $N\ge 9$, for which no network was trained; \FiveA {} at $N=3$, 13 and 15--20, not run}{table.caption.44}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces \textbf  {Rubik's Cube}, Santa 2023 puzzles: mean solution length in QTM, the competition's score, of every method on the same puzzles ($n$ per size). In each row the \textcolor {red}{\textbf  {best}} method is red and the \textcolor {green!50!black}{\textbf  {second best}} green; only methods that solved every puzzle of that size are ranked. \textsc  {KMC-published}\xspace  : KMCoders' published best-of-many solutions; \textsc  {KMC-one run}\xspace  : one run of their program; \textsc  {dwalton76}\xspace  : dwalton76's solver (\S  \ref {sec:baselines}). A superscript gives the number of puzzles run when below $n$. Santa cubes up to $N=10$ (\S  \ref {sec:data}); \textsc  {SymPort}\xspace  was not run on the 10$\times $10$\times $10\xspace   (--; \S  \ref {sec:m7scale}).}}{11}{table.caption.45}\protected@file@percent }
\newlabel{tab:maincube}{{6}{11}{\textbf {Rubik's Cube}, Santa 2023 puzzles: mean solution length in QTM, the competition's score, of every method on the same puzzles ($n$ per size). In each row the \best {best} method is red and the \second {second best} green; only methods that solved every puzzle of that size are ranked. \Bone : KMCoders' published best-of-many solutions; \Btwo : one run of their program; \Bthree : dwalton76's solver (\S \ref {sec:baselines}). A superscript gives the number of puzzles run when below $n$. Santa cubes up to $N=10$ (\S \ref {sec:data}); \Mseven was not run on the \Cu {10} (--; \S \ref {sec:m7scale})}{table.caption.45}{}}
