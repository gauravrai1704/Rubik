\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces \textbf  {Rubik's Square}, random states: mean solution length (HTM; on the Square HTM\,=\,QTM) of every method on the same instances ($n$ per size). In each row the \textcolor {red}{\textbf  {best}} method is red and the \textcolor {green!50!black}{\textbf  {second best}} green; only methods that solved every instance of that size are ranked, and ties share the colour. Method\nonbreakingspace 1\xspace  : exact optimum (breadth-first search for $N\le 4$, IDA* for $N=5$). Method\nonbreakingspace 4\xspace  : per-size network, $W{=}4096$. A superscript gives the solved fraction when below 100\%. A dash means no result, for three reasons: Method\nonbreakingspace 1\xspace  {} at $N\ge 6$, where no optimal solver finishes (0/10 states at $N=6$); Method\nonbreakingspace 4\xspace  {} at $N\ge 9$, for which no network was trained; Method\nonbreakingspace 5A\xspace  {} at $N=3$, 13 and 15--20, not run.}}{11}{table.caption.45}\protected@file@percent }
\newlabel{tab:mainsq}{{4}{11}{\textbf {Rubik's Square}, random states: mean solution length (HTM; on the Square HTM\,=\,QTM) of every method on the same instances ($n$ per size). In each row the \best {best} method is red and the \second {second best} green; only methods that solved every instance of that size are ranked, and ties share the colour. \Mone : exact optimum (breadth-first search for $N\le 4$, IDA* for $N=5$). \Mfour : per-size network, $W{=}4096$. A superscript gives the solved fraction when below 100\%. A dash means no result, for three reasons: \Mone {} at $N\ge 6$, where no optimal solver finishes (0/10 states at $N=6$); \Mfour {} at $N\ge 9$, for which no network was trained; \FiveA {} at $N=3$, 13 and 15--20, not run}{table.caption.45}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Rubik's Cube}, Santa 2023 puzzles: mean solution length in QTM, the competition's score, of every method on the same puzzles ($n$ per size). In each row the \textcolor {red}{\textbf  {best}} method is red and the \textcolor {green!50!black}{\textbf  {second best}} green; only methods that solved every puzzle of that size are ranked. B1: KMCoders' published best-of-many solutions; B2: one run of their program; B3: dwalton76 (\S  \ref {sec:baselines}). A superscript gives the number of puzzles run when below $n$. A dash means not run, because of cost: Method\nonbreakingspace 7\xspace  {} and B2 at $N=19$ (hours of CPU per copy); B3 at $N\ge 8$ (run for $N\le 7$ only).}}{11}{table.caption.46}\protected@file@percent }
\newlabel{tab:maincube}{{5}{11}{\textbf {Rubik's Cube}, Santa 2023 puzzles: mean solution length in QTM, the competition's score, of every method on the same puzzles ($n$ per size). In each row the \best {best} method is red and the \second {second best} green; only methods that solved every puzzle of that size are ranked. B1: KMCoders' published best-of-many solutions; B2: one run of their program; B3: dwalton76 (\S \ref {sec:baselines}). A superscript gives the number of puzzles run when below $n$. A dash means not run, because of cost: \Mseven {} and B2 at $N=19$ (hours of CPU per copy); B3 at $N\ge 8$ (run for $N\le 7$ only)}{table.caption.46}{}}
